{
  "name": "@blobbies/svelte",
  "version": "0.3.0",
  "description": "Svelte bindings for Blobbies \u2014 deterministic, cute SVG avatars with blink and cursor-follow.",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "keywords": [
    "avatar",
    "avatars",
    "svelte",
    "svg",
    "blobbies",
    "profile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SouravInsights/blobbies.git",
    "directory": "packages/svelte"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "blobbies": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/svelte": "^5.2.6",
    "jsdom": "^25.0.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
