{
  "name": "@blobbies/vue",
  "version": "0.2.0",
  "description": "Vue bindings for Blobbies \u2014 deterministic, cute SVG avatars with blink and cursor-follow.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "avatar",
    "avatars",
    "vue",
    "svg",
    "blobbies",
    "profile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SouravInsights/blobbies.git",
    "directory": "packages/vue"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "blobbies": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.13",
    "jsdom": "^25.0.1",
    "vue": "^3.5.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
