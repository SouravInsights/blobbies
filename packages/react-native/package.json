{
  "name": "@blobbies/react-native",
  "version": "0.2.0",
  "description": "Blobbies for React Native \u2014 the same deterministic avatars, drawn with react-native-svg.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "avatar",
    "avatars",
    "react-native",
    "expo",
    "svg",
    "blobbies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SouravInsights/blobbies.git",
    "directory": "packages/react-native"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "blobbies": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "react-native-svg": ">=13.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "react-native": "^0.76.0",
    "react-native-svg": "^15.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
