{
  "name": "blobbies",
  "version": "0.7.0",
  "description": "Deterministic, cute SVG blobby avatars generated from a name. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "avatar",
    "avatars",
    "svg",
    "initials",
    "blob",
    "generator",
    "deterministic",
    "profile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SouravInsights/blobbies.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "blobbies": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./motion": {
      "import": {
        "types": "./dist/motion.d.ts",
        "default": "./dist/motion.js"
      },
      "require": {
        "types": "./dist/motion.d.cts",
        "default": "./dist/motion.cjs"
      }
    },
    "./picker": {
      "import": {
        "types": "./dist/picker.d.ts",
        "default": "./dist/picker.js"
      },
      "require": {
        "types": "./dist/picker.d.cts",
        "default": "./dist/picker.cjs"
      }
    },
    "./package.json": "./package.json",
    "./manifest.json": "./manifest.json"
  },
  "files": [
    "dist",
    "manifest.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:fixtures": "tsx scripts/export-fixtures.ts",
    "export:manifest": "tsx scripts/export-manifest.ts",
    "codegen:swift": "tsx scripts/emit-swift.ts",
    "typecheck": "tsc --noEmit",
    "preview:letters": "tsx scripts/preview-letters.ts",
    "preview:avatars": "tsx scripts/preview-avatars.ts",
    "preview:blink": "tsx scripts/preview-blink.ts"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2"
  }
}
