{
  "name": "blobbies-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter blobbies-site dev",
    "preview:letters": "pnpm --filter blobbies preview:letters",
    "preview:avatars": "pnpm --filter blobbies preview:avatars",
    "preview:blink": "pnpm --filter blobbies preview:blink",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check:release": "node scripts/check-release.mjs",
    "example": "node scripts/example.mjs"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
