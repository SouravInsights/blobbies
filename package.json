{
  "name": "blobbies-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter blobbies-demo dev",
    "preview:letters": "pnpm --filter blobbies preview:letters",
    "preview:avatars": "pnpm --filter blobbies preview:avatars",
    "preview:blink": "pnpm --filter blobbies preview:blink",
    "build:packages": "pnpm -r --filter \"./packages/*\" build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
