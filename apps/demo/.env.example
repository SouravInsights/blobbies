# PostHog project token (phc_...) and host. These are public client values: the
# token is write-only and ships in the browser bundle by design.
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Owner opt-out: open the site with ?ph_opt_out=true once. PostHog remembers
# the opt-out in this browser. Use ?ph_opt_in=true to re-enable it.